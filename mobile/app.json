{
    "expo": {
        "name": "Tomo Vision",
        "slug": "tomo-vision",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/cblogo.png",
        "splash": {
            "image": "./assets/cblogo.png",
            "resizeMode": "contain",
            "backgroundColor": "#0f1f10"
        },
        "updates": {
            "fallbackToCacheTimeout": 0
        },
        "assetBundlePatterns": [
            "**/*"
        ],
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.tomovision.app"
        },
        "android": {
            "permissions": [
                "CAMERA",
                "READ_EXTERNAL_STORAGE"
            ],
            "package": "com.tomovision.app",
            "adaptiveIcon": {
                "foregroundImage": "./assets/cblogo.png",
                "backgroundColor": "#0f1f10"
            }
        },
        "web": {},
        "extra": {
            "apiUrl": "http://10.0.2.2:8000/predict"
        }
    }
}