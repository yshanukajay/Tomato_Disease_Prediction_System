{
  "expo": {
    "name": "Tomo Vision",
    "slug": "tomo-vision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cblogo.png",
    "splash": {
      "image": "./assets/cblogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1f10"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tomovision.app"
    },
    "android": {
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],
      "package": "com.tomovision.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/cblogo.png",
        "backgroundColor": "#0f1f10"
      }
    },
    "web": {},
    "extra": {
      "apiUrl": "http://172.16.193.34:8000/predict",
      "eas": {
        "projectId": "2a4a6949-8d5f-431f-8c66-ae0d9084eb47"
      }
    }
  }
}